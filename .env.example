# Copy to .env and fill in. Leave values empty here; never commit real values.

# --- Build-time: baked into the browser bundle, passed as Docker build args ---

# Supabase project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=""

# Supabase publishable (anon) key for client-side auth and data access
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase project identifier (e.g., xxxxxxxxxxabcdefghij)
VITE_SUPABASE_PROJECT_ID=""

# Canonical public origin of the app, used in shared links and meta tags (e.g. https://sthenos.live)
VITE_PUBLIC_SITE_URL=""

# --- Runtime: server only, read from the environment when the server starts ---

# Supabase project URL used by server-side code
SUPABASE_URL=""

# Supabase publishable key used by server-side auth calls
SUPABASE_PUBLISHABLE_KEY=""

# Supabase service-role key; bypasses RLS, must never reach the browser
SUPABASE_SERVICE_ROLE_KEY=""

# Platform Stripe secret key used by the Connect and webhook flows
STRIPE_SECRET_KEY=""

# Signing secret for the Stripe Connect webhook
STRIPE_WEBHOOK_SECRET=""

# Platform Stripe secret key for sandbox (test mode)
STRIPE_SANDBOX_API_KEY=""

# Platform Stripe secret key for live mode
STRIPE_LIVE_API_KEY=""

# Signing secret for the sandbox platform webhook (/api/public/payments/webhook?env=sandbox)
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""

# Signing secret for the live platform webhook (/api/public/payments/webhook?env=live)
PAYMENTS_LIVE_WEBHOOK_SECRET=""

# Resend API key used to send email
RESEND_API_KEY=""

# Verified sending domain for platform email (e.g. notify.sthenos.live)
EMAIL_SENDING_DOMAIN=""

# Local part of the platform sender address (defaults to noreply)
EMAIL_SENDING_LOCAL_PART=""

# Set to "true" once EMAIL_SENDING_DOMAIN is verified with Resend
EMAIL_SENDING_VERIFIED=""

# Secret that verifies requests from the Supabase send-email auth hook
SEND_EMAIL_HOOK_SECRET=""

# Bearer token that authorises the scheduled /api/public/hooks calls
CRON_SECRET=""

# Anthropic API key for the AI analysis feature
ANTHROPIC_API_KEY=""

# Anthropic model name for the AI analysis feature
ANTHROPIC_MODEL=""

# Public origin of the app for redirects and links; takes precedence over SITE_URL
APP_URL=""

# Fallback app origin for redirects when APP_URL is unset
SITE_URL=""

# Canonical hostname; www.<CANONICAL_HOST> redirects to it (leave unset to disable)
CANONICAL_HOST=""

# Cloudflare Turnstile secret for bot checks on public forms (unset disables the check)
TURNSTILE_SECRET_KEY=""

# --- docker compose only: consumed by the compose setup, not read by the app ---

# Domain the reverse proxy serves the app on
APP_DOMAIN=""

# Container image tag to deploy
IMAGE_TAG=""

# GitHub Container Registry owner the image is pulled from
GHCR_OWNER=""
